diff --git a/libs/ardour/dsp_filter.cc b/libs/ardour/dsp_filter.cc
index 8c93372689..167f61d3ef 100644
--- a/libs/ardour/dsp_filter.cc
+++ b/libs/ardour/dsp_filter.cc
@@ -154,6 +154,69 @@ LowPass::ctrl (float* data, const float val, const uint32_t n_samples)
 	_z = z;
 }
 
+TransientShaper::TransientShaper (double samplerate)
+	: _rate (samplerate)
+	, _fast_envelope (0.f)
+	, _slow_envelope (0.f)
+	, _attack_gain (1.f)
+	, _sustain_gain (1.f)
+	, _sensitivity (1.f)
+	, _mix (1.f)
+	, _output_gain (1.f)
+{
+}
+
+void
+TransientShaper::run (float* data, uint32_t n_samples, float attack_db, float sustain_db, float sensitivity, float release_ms, float mix, float output_db)
+{
+	if (!data || n_samples == 0 || _rate <= 0) {
+		return;
+	}
+
+	const float target_attack_gain = dB_to_coefficient (attack_db);
+	const float target_sustain_gain = dB_to_coefficient (sustain_db);
+	const float target_output_gain = dB_to_coefficient (output_db);
+	const float target_mix = std::max (0.f, std::min (1.f, mix / 100.f));
+	const float target_sensitivity = std::max (0.1f, std::min (4.f, sensitivity));
+	const float release = std::max (20.f, std::min (500.f, release_ms)) * 0.001f;
+	const float smoothing = 1.f - expf (-static_cast<float> (n_samples) / (0.01f * _rate));
+
+	_attack_gain += smoothing * (target_attack_gain - _attack_gain);
+	_sustain_gain += smoothing * (target_sustain_gain - _sustain_gain);
+	_sensitivity += smoothing * (target_sensitivity - _sensitivity);
+	_mix += smoothing * (target_mix - _mix);
+	_output_gain += smoothing * (target_output_gain - _output_gain);
+
+	const float fast_attack = expf (-1.f / (0.0005f * _rate));
+	const float slow_attack = expf (-1.f / (0.025f * _rate));
+	const float fast_release = expf (-1.f / (0.01f * _rate));
+	const float slow_release = expf (-1.f / (release * _rate));
+
+	for (uint32_t i = 0; i < n_samples; ++i) {
+		const float input = data[i];
+		const float level = fabsf (input);
+
+		const float fast_coefficient = level > _fast_envelope ? fast_attack : fast_release;
+		_fast_envelope = level + fast_coefficient * (_fast_envelope - level);
+
+		const float slow_coefficient = level > _slow_envelope ? slow_attack : slow_release;
+		_slow_envelope = level + slow_coefficient * (_slow_envelope - level);
+
+		const float attack_weight = std::max (0.f, std::min (1.f,
+			(_fast_envelope - _slow_envelope) / std::max (_fast_envelope, 0.000001f) * _sensitivity));
+		const float shaped_gain = _sustain_gain + attack_weight * (_attack_gain - _sustain_gain);
+		const float wet = input * shaped_gain * _output_gain;
+		data[i] = input + _mix * (wet - input);
+	}
+
+	if (!isfinite_local (_fast_envelope) || !std::isnormal (_fast_envelope)) {
+		_fast_envelope = 0.f;
+	}
+	if (!isfinite_local (_slow_envelope) || !std::isnormal (_slow_envelope)) {
+		_slow_envelope = 0.f;
+	}
+}
