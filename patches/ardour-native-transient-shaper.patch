+
+void
+LuaScriptTest::transient_shaper_signal_test ()
+{
+	std::vector<float> unity_signal (64);
+	for (size_t i = 0; i < unity_signal.size (); ++i) {
+		unity_signal[i] = (i & 1) ? -0.25f : 0.25f;
+	}
+
+	DSP::TransientShaper unity_shaper (48000.0);
+	unity_shaper.run (unity_signal.data (), unity_signal.size (), 0.f, 0.f, 1.f, 120.f, 100.f, 0.f);
+	for (size_t i = 0; i < unity_signal.size (); ++i) {
+		CPPUNIT_ASSERT_DOUBLES_EQUAL ((i & 1) ? -0.25 : 0.25, unity_signal[i], 1e-6);
+	}
+
+	std::vector<float> gain_signal (4800, 0.25f);
+	DSP::TransientShaper gain_shaper (48000.0);
+	gain_shaper.run (gain_signal.data (), gain_signal.size (), 0.f, 0.f, 1.f, 120.f, 100.f, 6.f);
+	CPPUNIT_ASSERT_DOUBLES_EQUAL (0.25 * dB_to_coefficient (6.f), gain_signal.back (), 1e-3);
+}
